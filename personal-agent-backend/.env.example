# ========== DeepSeek 大模型（必填）==========
# 在 https://platform.deepseek.com/api_keys 创建 API Key
LLM_API_KEY=sk-你的DeepSeek密钥
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 可选：深度思考模型（更慢、更强推理）
# LLM_MODEL=deepseek-reasoner

# ========== Embedding（RAG 向量，推荐阿里云）==========
# 在 https://dashscope.console.aliyun.com/ 创建 API Key（百炼 / DashScope）
# 配置后需重新入库：python scripts/ingest.py
EMBED_API_KEY=sk-你的阿里云DashScope密钥
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_MODEL=text-embedding-v3

# 留空 EMBED_API_KEY 时自动使用本地 fallback 向量（检索质量较差，仅适合调试）

# ========== 长期记忆（默认 SQLite+FTS5+向量，无需 Elasticsearch）==========
SEARCH_BACKEND=sqlite
# 若有大内存机器可改回: SEARCH_BACKEND=es 并配置 ES_URL
# ES_URL=http://127.0.0.1:9200
ES_KEYWORD_CANDIDATES=24
ES_VECTOR_CANDIDATES=24
ES_RERANK_TOP_N=16
ES_MIN_RECALL_SCORE=0.22

# ========== 机器人连接鉴权（与固件 menuconfig 一致）==========
API_TOKEN=dev-token

# ========== 数据路径 ==========
PERSONA_DIR=../persona
PERSONA_PATH=../persona/config/persona.md
PROFILE_CARD_PATH=../persona/config/profile_card.md
STYLE_DIR=../persona/style
CORPUS_DIR=../persona/corpus
CHROMA_PATH=./chroma_data
DB_PATH=./agent.db

# ========== 记忆参数 ==========
WORKING_MEMORY_TURNS=20
L1_COMPRESS_BATCH_TURNS=12
L2_RETENTION_DAYS=7
L2_RECALL_RECENT=3
L2_EMBED_POOL=15
L2_SIM_THRESHOLD=0.6
RAG_TOP_K=5
L3_RECALL_MODE=cascade
L3_DENOISE_ENABLED=true
# 留空 = 不跳过 corpus 文件（import_wechat 生成的月度总结可直接 ingest）
L3_NOISE_FILE_PATTERNS=
EPISODIC_TOP_K=3
AUTO_EXTRACT_FACTS=false
PERSON_PROFILE_AUTO_UPDATE=true
# 临时画像→v1：any=满足任一规则；all=全部规则都满足
PROFILE_PROMOTION_MODE=any
PROFILE_PROMOTION_RULES=relationship_declared,substantive_fact,l2_episode,profile_long_memory,user_remember_intent
MEMORY_AUTO_CORRECT=true
SESSION_IDLE_MINUTES=10
MAX_REPLY_CHARS=150

# ========== 核心记忆 ==========
# 每日凌晨批量升级：长期记忆被检索≥3 次且置信度=1.0 才写入核心记忆（即时入库走用户明确陈述）
L0_BATCH_HOUR=0
L0_BATCH_MIN_RECALL=3
L0_BATCH_MIN_CONFIDENCE=1.0

# Profile 履历归档（每周日凌晨 3 点；数据源=过去7天 L2+L3，不重读 L1）
PROFILE_BATCH_WEEKDAY=6
PROFILE_BATCH_HOUR=3
PROFILE_BATCH_LOOKBACK_DAYS=7
PERSON_PROFILE_AUTO_UPDATE=false

# persona/corpus/ ingest：启动时是否同步；全量 reset 很慢，日常重启保持 false
PERSONA_INGEST_ON_STARTUP=true
PERSONA_INGEST_RESET_ON_STARTUP=false
# 入库后是否批量处理语料（建关联图）
PERSONA_INGEST_EXTRACT_FACTS=true
# 共享用户 ID
PERSONA_FACT_PERSON_ID=persona_global

# 访客身份：每 N 轮提醒一次发送「名字 XXX ID xxx」（已实名用户不提醒）
GUEST_IDENTITY_REMINDER_EVERY=3

# 记忆关联网络：检索时展开 strength≥该阈值 的联想记忆
MEMORY_RELATION_MIN_STRENGTH=0.6

# ========== 对话角色（默认女友，口令切换）==========
# 女友 person_id（已在 person_profiles 里注册时填写；留空则按显示名查库）
# DEFAULT_OWNER_PERSON_ID=huihui
DEFAULT_OWNER_DISPLAY_NAME=刘远慧

# ========== 服务 ==========
HOST=0.0.0.0
PORT=8001

# ========== TTS 语音合成（百度 text2audio）==========
# 留空则 TTS 关闭，只发文本 bubbles（兼容旧固件）
TTS_API_KEY=
# 发音人: 4100=度小乔, 4103=度小贤, 4117=度小鹿
# TTS_SPEAKER_VOICE=4100
# TTS_SPEED=6
# TTS_PITCH=5
# TTS_VOLUME=8
# pcm=raw PCM (aue=4，推荐); wav=WAV (aue=6)
# TTS_AUDIO_FORMAT=pcm

# ========== 声音复刻（百度大模型声音复刻）==========
# 在 https://console.bce.baidu.com/iam/#/iam/apikey/list 创建
# 填了以下两项就走声音复刻接口，否则走上面旧版 TTS
BAIDU_API_KEY=
# 音色 ID：运行 scripts/create_voice.py 上传音频后获得
TTS_CLONE_VOICE_ID=

# ========== 控制台日志（阶段 3.0）==========
# 日志模式: silent=仅启动/错误, normal=核心链路, debug=详细(含MemoryPack/Prompt), trace=全部底层
# CONSOLE_LOG_MODE=normal
# normal 模式是否显示记忆包摘要
# CONSOLE_LOG_MEMORY_DETAIL=true
# debug/trace 模式是否展开 prompt 预览
# CONSOLE_LOG_PROMPT_PREVIEW=false
# 是否显示各阶段耗时
# CONSOLE_LOG_TIMING=true
# 控制台分隔线宽度
# CONSOLE_LOG_WIDTH=100
